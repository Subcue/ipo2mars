{
  "name": "ipo2mars",
  "private": true,
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./public/styles.css --minify",
    "build:client": "node scripts/build-client.mjs",
    "build": "npm run build:css && npm run build:client",
    "dev:css": "tailwindcss -i ./src/input.css -o ./public/styles.css --watch",
    "dev:client": "node scripts/build-client.mjs --watch",
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.client.json"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.4",
    "@react-three/fiber": "^9.0.4",
    "@react-three/postprocessing": "^3.0.4",
    "hono": "^4.12.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "satellite.js": "^5.0.0",
    "three": "^0.171.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260310.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.171.0",
    "esbuild": "^0.24.2",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "wrangler": "^4.71.0"
  }
}
